# Copy this file to .env and fill in values when the integrations are enabled.
# API key Google Cloud Vision; jangan pernah commit file .env asli.
GOOGLE_VISION_API_KEY=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
# Konfigurasi batch IMAP invoice; koneksi selalu read-only dan memakai BODY.PEEK[].
IMAP_INTAKE_MAILBOX=INBOX
IMAP_INTAKE_TIMEOUT_SECONDS=30
IMAP_ATTACHMENT_MAX_BYTES=10485760
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Lifetime token approval dalam jam; harus antara 1 dan 168.
APPROVAL_TOKEN_TTL_HOURS=24
HEADLESS=false
# Browser timeout untuk Google Forms (milidetik).
ERP_BROWSER_TIMEOUT_MS=30000

